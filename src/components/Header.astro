---
import { localeLabels, defaultLocale, type Locale } from '../i18n/index';

interface Props {
  t: any;
  locale: Locale;
  currentPath?: string;
}

const { t, locale, currentPath = '' } = Astro.props;

function switchUrl(loc: string) {
  if (loc === defaultLocale) return `/${currentPath}`;
  return `/${loc}/${currentPath}`;
}
---

<header style="position:sticky;top:0;z-index:50;display:flex;align-items:stretch;justify-content:space-between;gap:28px;background:#F2F0EC;border-bottom:1px solid rgba(0,0,0,0.08);">

  <!-- Logo — pleine hauteur -->
  <a href={locale === defaultLocale ? '/' : `/${locale}/`} style="display:flex;align-items:center;flex:none;padding:0 28px;">
    <img
      src="/images/logo.png"
      alt="The Stone Family"
      style="height:72px;width:auto;display:block;"
    />
  </a>

  <!-- Navigation principale -->
  <nav style="display:flex;align-items:center;flex-wrap:wrap;gap:10px 26px;font-size:13px;letter-spacing:0.07em;text-transform:uppercase;">
    <a href="#pierre" style="color:#1a1a1a;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">{t.nav.stone}</a>
    <a href="#carriere" style="color:#1a1a1a;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">{t.nav.quarry}</a>
    <a href="#finitions" style="color:#1a1a1a;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">{t.nav.finishes}</a>
    <a href="#export" style="color:#1a1a1a;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">{t.nav.export}</a>
    <a href="#contact" style="color:#1a1a1a;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">{t.nav.contact}</a>
  </nav>

  <!-- Sélecteur de langue + CTA -->
  <div style="display:flex;align-items:center;gap:12px 18px;padding:0 28px;">

    <!-- Langues -->
    <div style="display:flex;align-items:center;gap:2px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;">
      {Object.entries(localeLabels).map(([loc, label]) => (
        <a
          href={switchUrl(loc)}
          style={`padding:5px 7px;color:${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.4)'};transition:color 0.2s;text-decoration:none;`}
          onmouseover="this.style.color='#1a1a1a'"
          onmouseout={`this.style.color='${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.4)'}'`}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <a
      href="#contact"
      style="padding:11px 22px;border:1px solid #C8A96A;color:#C8A96A;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;white-space:nowrap;transition:all 0.2s;text-decoration:none;"
      onmouseover="this.style.background='#C8A96A';this.style.color='#fff';"
      onmouseout="this.style.background='transparent';this.style.color='#C8A96A';"
    >
      {t.cta_sample}
    </a>
  </div>

</header>
