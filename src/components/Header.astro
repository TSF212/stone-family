---
import { localeLabels, defaultLocale, type Locale } from '../i18n/index';
import { supplyUrl } from '../i18n/supply';

interface Props {
  t: any;
  locale: Locale;
  currentPath?: string;
}

const { t, locale, currentPath = '' } = Astro.props;
const productLabels: Record<Locale, [string, string]> = {
  fr: ['Blocs', 'Tranches'], en: ['Blocks', 'Slabs'], it: ['Blocchi', 'Lastre'],
  es: ['Bloques', 'Tablas'], ar: ['الكتل', 'الألواح'],
};
const [blocksLabel, slabsLabel] = productLabels[locale];

function switchUrl(loc: string) {
  if (loc === defaultLocale) return `/${currentPath}`;
  return `/${loc}/${currentPath}`;
}
---

<header id="site-header" style="position:sticky;top:0;z-index:50;background:#F2F0EC;border-bottom:1px solid rgba(0,0,0,0.08);">

  <!-- BARRE PRINCIPALE -->
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0 20px;height:72px;">

    <!-- Logo -->
    <a href={locale === defaultLocale ? '/' : `/${locale}/`} style="display:flex;align-items:center;flex:none;">
      <img src="/images/logo.png" alt="The Stone Family" style="height:56px;width:auto;display:block;" />
    </a>

    <!-- Navigation desktop -->
    <nav id="nav-desktop" style="display:none;align-items:center;gap:16px;font-size:13px;letter-spacing:0.05em;text-transform:uppercase;">
      <a href={supplyUrl(locale, 'blocks')} class="nav-link">{blocksLabel}</a>
      <a href={supplyUrl(locale, 'slabs')} class="nav-link">{slabsLabel}</a>
      <a href="#pierre" class="nav-link">{t.nav.stone}</a>
      <a href="#carriere" class="nav-link">{t.nav.quarry}</a>
      <a href="#finitions" class="nav-link">{t.nav.finishes}</a>
      <a href="#export" class="nav-link">{t.nav.export}</a>
      <a href="#contact" class="nav-link">{t.nav.contact}</a>
    </nav>

    <!-- Droite desktop : langues + CTA + WhatsApp -->
    <div id="right-desktop" style="display:none;align-items:center;gap:14px;">
      <div style="display:flex;align-items:center;gap:2px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;">
        {Object.entries(localeLabels).map(([loc, label]) => (
          <a
            href={switchUrl(loc)}
            style={`padding:5px 7px;color:${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.35)'};transition:color 0.2s;text-decoration:none;`}
            onmouseover="this.style.color='#1a1a1a'"
            onmouseout={`this.style.color='${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.35)'}'`}
          >{label}</a>
        ))}
      </div>
      <a href="#contact"
        style="padding:10px 20px;border:1px solid #C8A96A;color:#C8A96A;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;white-space:nowrap;transition:all 0.2s;text-decoration:none;"
        onmouseover="this.style.background='#C8A96A';this.style.color='#fff';"
        onmouseout="this.style.background='transparent';this.style.color='#C8A96A';"
      >{t.cta_sample}</a>
    </div>

    <!-- Hamburger mobile -->
    <button id="burger" aria-label="Menu" aria-controls="mobile-menu" aria-expanded="false" style="display:flex;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:8px;">
      <span class="burger-line" style="display:block;width:24px;height:1.5px;background:#1a1a1a;transition:all 0.3s;"></span>
      <span class="burger-line" style="display:block;width:24px;height:1.5px;background:#1a1a1a;transition:all 0.3s;"></span>
      <span class="burger-line" style="display:block;width:24px;height:1.5px;background:#1a1a1a;transition:all 0.3s;"></span>
    </button>

  </div>

  <nav class="supply-shortcuts" aria-label={locale === 'fr' ? 'Blocs et tranches' : `${blocksLabel} · ${slabsLabel}`}>
    <a href={supplyUrl(locale, 'blocks')}>{blocksLabel} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>
    <a href={supplyUrl(locale, 'slabs')}>{slabsLabel} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>
  </nav>

  <!-- MENU MOBILE (panneau) -->
  <div id="mobile-menu" style="display:none;flex-direction:column;background:#F2F0EC;border-top:1px solid rgba(0,0,0,0.08);padding:24px 20px 32px;">

    <!-- Liens nav -->
    <nav style="display:flex;flex-direction:column;gap:0;">
      <a href={supplyUrl(locale, 'blocks')} class="mob-link">{blocksLabel}</a>
      <a href={supplyUrl(locale, 'slabs')} class="mob-link">{slabsLabel}</a>
      <a href="#pierre" class="mob-link">{t.nav.stone}</a>
      <a href="#carriere" class="mob-link">{t.nav.quarry}</a>
      <a href="#finitions" class="mob-link">{t.nav.finishes}</a>
      <a href="#export" class="mob-link">{t.nav.export}</a>
      <a href="#contact" class="mob-link">{t.nav.contact}</a>
    </nav>

    <!-- Langues -->
    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:24px;padding-top:20px;border-top:1px solid rgba(0,0,0,0.08);font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;">
      {Object.entries(localeLabels).map(([loc, label]) => (
        <a
          href={switchUrl(loc)}
          style={`padding:8px 12px;color:${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.4)'};text-decoration:none;border:1px solid ${loc === locale ? '#C8A96A' : 'rgba(0,0,0,0.12)'};`}
        >{label}</a>
      ))}
    </div>

    <!-- CTA mobile -->
    <a href="#contact"
      style="margin-top:20px;padding:14px 20px;background:#C8A96A;color:#0B0B09;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;text-align:center;text-decoration:none;display:block;"
    >{t.cta_sample}</a>

  </div>

</header>

<style>
  .supply-shortcuts { display:flex;gap:28px;padding:12px 20px;border-top:1px solid rgba(0,0,0,0.08);color:#1a1a1a;font-size:14px;letter-spacing:0.06em; }
  .supply-shortcuts a:hover { color:#755728; }
  .nav-link, .supply-shortcuts a { white-space:nowrap; }
  .nav-link {
    color: #1a1a1a;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: #C8A96A; }

  .mob-link {
    display: block;
    padding: 16px 0;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    transition: color 0.2s;
  }
  .mob-link:hover { color: #C8A96A; }

  /* Desktop : afficher nav + right, cacher burger */
  @media (min-width: 1200px) {
    #nav-desktop { display: flex !important; }
    #right-desktop { display: flex !important; }
    #burger { display: none !important; }
    #mobile-menu { display: none !important; }
    .supply-shortcuts { display: none; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const lines = document.querySelectorAll('.burger-line');
  let open = false;

  burger.addEventListener('click', () => {
    open = !open;
    burger.setAttribute('aria-expanded', String(open));
    menu.style.display = open ? 'flex' : 'none';
    // Animation hamburger → croix
    if (open) {
      lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      lines[1].style.opacity = '0';
      lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    } else {
      lines[0].style.transform = 'none';
      lines[1].style.opacity = '1';
      lines[2].style.transform = 'none';
    }
  });

  function closeMenu() {
    open = false;
    burger.setAttribute('aria-expanded', 'false');
    menu.style.display = 'none';
    lines[0].style.transform = 'none';
    lines[1].style.opacity = '1';
    lines[2].style.transform = 'none';
  }

  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

  // Fermer le menu en cliquant ailleurs
  document.addEventListener('click', (e) => {
    if (!document.getElementById('site-header').contains(e.target)) closeMenu();
  });
</script>
