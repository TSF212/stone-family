---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import { t as translate } from '../i18n/index';
import { locales, localeLabels, localePath, type Locale } from '../i18n/index';
import { supplyContent, supplyUrl, supplyAlternates, type SupplyKind } from '../i18n/supply';

interface Props { locale: Locale; kind: SupplyKind }
const { locale, kind } = Astro.props;
const copy = supplyContent[locale];
const product = copy[kind];
const home = localePath(locale);
const contact = `${home}#contact`;
const relatedKind = kind === 'blocks' ? 'slabs' : 'blocks';
const alternates = supplyAlternates(kind);
---
<BaseLayout title={`${product.title} | The Stone Family`} description={product.description} locale={locale} alternatePaths={alternates}>
  <Header t={translate(locale)} locale={locale} homePath={home} alternatePaths={alternates} />
  <main>
    <section class="intro wrap">
      <div class="page-tools">
        <nav class="breadcrumb" aria-label={copy.breadcrumb}><a href={home}>{copy.home}</a><span aria-hidden="true"> / </span><span>{product.label}</span></nav>
        <nav class="languages" aria-label={copy.languages}>
          {locales.map(loc => <a href={supplyUrl(loc, kind)} lang={loc} hreflang={loc} aria-current={loc === locale ? 'page' : undefined}>{localeLabels[loc]}</a>)}
        </nav>
      </div>
      <p class="eyebrow"><bdi>The Stone Family</bdi> · {copy.label}</p>
      <h1>{product.heading}</h1>
      <p class="lead">{product.lead}</p>
      <a class="cta" href={contact}>{product.cta} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>
    </section>
    <section class="light"><div class="wrap"><p class="eyebrow">{copy.selection}</p><h2>{product.selectionTitle}</h2><div class="cards">{product.steps.map(([name, text], i) => <article><span class="number">0{i + 1}</span><h3>{name}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="wrap split"><div><p class="eyebrow">{copy.request}</p><h2>{copy.requestTitle}</h2><p>{copy.requestLead}</p></div><ul>{product.checklist.map(item => <li>{item}</li>)}</ul></section>
    <section class="light"><div class="wrap"><h2>{copy.deliveryTitle}</h2>{copy.delivery.map(text => <p>{text}</p>)}</div></section>
    <section class="wrap"><p class="eyebrow">{copy.questions}</p><h2>{product.faqTitle}</h2>{product.faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</section>
    <section class="wrap closing"><h2>{copy.closingTitle}</h2><p>{copy.closing}</p><a class="cta" href={contact}>{copy.contact} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a><a class="related" href={supplyUrl(locale, relatedKind)}>{product.related} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a></section>
  </main>
  <footer class="wrap"><bdi>The Stone Family</bdi> · <a href={home}>{copy.home}</a> · <a href={contact}>{copy.contact}</a></footer>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:copy.home,item:new URL(home, Astro.site).href},{'@type':'ListItem',position:2,name:product.label,item:new URL(supplyUrl(locale, kind), Astro.site).href}]})} />
</BaseLayout>
<style>
  .wrap{max-width:1160px;margin:auto;padding:72px 28px}.supply-header{background:#E8E3D9;color:#252824;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 28px}.supply-header img{width:250px;height:80px;object-fit:contain}.supply-header nav{margin-inline-start:auto}.supply-header nav{display:flex;gap:22px;flex-wrap:wrap;line-height:1.6}.supply-header a[aria-current]{color:#755728}.page-tools{display:flex;justify-content:space-between;align-items:start;gap:24px;flex-wrap:wrap;margin-bottom:38px}.breadcrumb{font-size:14px;color:#bbb8ad;line-height:1.6}.breadcrumb a{text-decoration:underline;text-underline-offset:4px}.languages{display:flex;gap:6px;direction:ltr;flex-wrap:wrap;font-size:13px}.languages a{padding:7px 10px;border:1px solid #444238}.languages a[aria-current]{color:#24483E;border-color:#24483E}.eyebrow{color:#24483E;text-transform:uppercase;letter-spacing:.13em;font-size:12px;margin-bottom:22px}h1,h2,h3{font-family:Archivo,'Noto Kufi Arabic',system-ui,sans-serif;font-weight:500}h1{font-size:clamp(34px,6vw,64px);line-height:1.15;max-width:20ch;margin-bottom:28px}h2{font-size:clamp(27px,4vw,40px);line-height:1.3;margin-bottom:26px}h3{font-size:22px;line-height:1.4;margin:18px 0}p{font-size:18px;line-height:1.75;margin-bottom:20px}.lead{max-width:66ch;color:#bbb8ad}.cta{display:inline-block;background:#24483E;color:#F5F3ED;padding:16px 22px;font-weight:500;line-height:1.5;margin-top:12px}.light{background:#E8E3D9;color:#252824}.light .eyebrow{color:#755728}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.cards p{font-size:17px}.number{font-family:monospace;color:#755728}.split{display:grid;grid-template-columns:1fr 1fr;gap:48px}ul{padding-inline-start:24px}li{font-size:18px;line-height:1.7;margin-bottom:16px}details{border-bottom:1px solid #444238;padding:22px 0}summary{font-size:20px;cursor:pointer;line-height:1.5}details p{margin:18px 0 0;color:#bbb8ad}.closing{border-top:1px solid #444238}.related{display:block;color:#24483E;margin-top:28px;line-height:1.5}footer.wrap{padding-top:30px;padding-bottom:30px;font-size:14px;border-top:1px solid #444238}a:hover{text-decoration:underline;text-underline-offset:4px}.cta:hover{background:#252824;color:#F5F3ED}a:focus-visible,summary:focus-visible{outline:2px solid #24483E;outline-offset:5px}:global(html[dir="rtl"]) h1{line-height:1.65;font-size:clamp(29px,5vw,52px);max-width:25ch}:global(html[dir="rtl"]) h2,:global(html[dir="rtl"]) h3{line-height:1.8}:global(html[dir="rtl"]) p,:global(html[dir="rtl"]) li{line-height:2}:global(html[dir="rtl"]) .eyebrow{letter-spacing:0}@media(max-width:760px){.cards,.split{grid-template-columns:1fr}.wrap{padding:48px 20px}.supply-header{padding:8px 20px;flex-wrap:wrap}.supply-header img{width:190px;height:64px}.supply-header nav{gap:14px;font-size:14px}.page-tools{gap:18px}h1{overflow-wrap:anywhere}}
</style>
