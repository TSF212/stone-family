---
interface Props {
  t: any;
}
const { t } = Astro.props;
const accent = '#C8A96A';
const dark = '#0B0B09';
const light = '#EDEBE4';
const muted = 'rgba(237,235,228,0.55)';
const monoFont = "'IBM Plex Mono','Noto Kufi Arabic',monospace";
const titleFont = "'Archivo','Noto Kufi Arabic',system-ui,sans-serif";
const bodyFont = "'Barlow','Noto Kufi Arabic',system-ui,sans-serif";

// Placeholder visuel pour les images
const ph = (label: string, ratio = '4/3', dark2 = true) => `
  <div style="aspect-ratio:${ratio};background:${dark2 ? 'repeating-linear-gradient(122deg,#131209 0 10px,#191811 10px 20px)' : 'repeating-linear-gradient(122deg,#DCD8D0 0 10px,#E6E2DA 10px 20px)'};display:flex;align-items:flex-end;padding:18px;border:1px solid rgba(${dark2 ? '237,235,228' : '22,21,15'},0.09);">
    <span style="font-family:${monoFont};font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(${dark2 ? '237,235,228' : '22,21,15'},0.35);">${label}</span>
  </div>`;
---

<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<section style={`display:grid;grid-template-columns:1.05fr 0.95fr;align-items:stretch;min-height:82vh;border-bottom:1px solid rgba(237,235,228,0.09);`}>

  <div style="padding:96px 64px 88px 40px;display:flex;flex-direction:column;justify-content:center;max-width:860px;">
    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:34px;`}>
      {t.hero.eyebrow}
    </div>
    <h1 style={`font-family:${titleFont};font-weight:500;font-size:clamp(38px,4.4vw,68px);line-height:1.06;letter-spacing:-0.028em;margin:0 0 34px;`}
      set:html={t.hero.h1.replace('\n','<br>')}
    />
    <p style={`font-size:18px;line-height:1.72;color:${muted};margin:0 0 46px;max-width:52ch;`}>
      {t.hero.lead}
    </p>
    <div style="display:flex;align-items:center;gap:28px;flex-wrap:wrap;">
      <a
        href="#pierre"
        style={`display:inline-flex;align-items:center;gap:12px;padding:16px 30px;background:${light};color:${dark};font-family:${bodyFont};font-size:13px;letter-spacing:0.12em;text-transform:uppercase;transition:background 0.2s;`}
        onmouseover={`this.style.background='${accent}'`}
        onmouseout={`this.style.background='${light}'`}
      >
        {t.hero.cta_primary}
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="#contact"
        style={`font-family:${bodyFont};font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:${light};border-bottom:1px solid rgba(200,169,106,0.4);padding-bottom:3px;`}
      >
        {t.hero.cta_secondary}
      </a>
    </div>
  </div>

  <!-- Image hero -->
  <div style="position:relative;min-height:60vh;background:repeating-linear-gradient(122deg,#131209 0 10px,#191811 10px 20px);border-inline-start:1px solid rgba(237,235,228,0.09);display:flex;align-items:flex-end;padding:26px;">
    <!-- Remplacez par : <img src="/images/hero_slab.jpg" alt="Marbre noir Atlas - carrière Moyen Atlas Maroc" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" /> -->
    <span style={`font-family:${monoFont};font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(237,235,228,0.3);`}>
      hero_slab_polished.jpg — 1600 × 1200 px
    </span>
  </div>

</section>

<!-- ══════════════════════════════════════
     STATS
══════════════════════════════════════ -->
<section style="display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid rgba(237,235,228,0.09);">
  {t.stats.map((s: any, i: number) => (
    <div style={`padding:44px 32px;${i < 3 ? 'border-inline-end:1px solid rgba(237,235,228,0.09);' : ''}`}>
      <div style={`font-family:${titleFont};font-weight:500;font-size:clamp(30px,2.6vw,44px);letter-spacing:-0.025em;line-height:1;color:${accent};margin-bottom:14px;`}>
        {s.v}
      </div>
      <div style={`font-family:${bodyFont};font-size:13px;line-height:1.5;color:${muted};max-width:22ch;`}>
        {s.l}
      </div>
    </div>
  ))}
</section>

<!-- ══════════════════════════════════════
     LA PIERRE
══════════════════════════════════════ -->
<section id="pierre" style="background:#F2F0EC;color:#16150F;padding:118px 40px;">
  <div style="max-width:1280px;margin:0 auto;">

    <div style="font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(22,21,15,0.45);margin-bottom:40px;">
      {t.stone.label}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <div>
        <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(38px,4.2vw,62px);line-height:1.06;letter-spacing:-0.022em;margin:0 0 28px;`}>
          {t.stone.title}
        </h2>
        <p style="font-size:18px;line-height:1.75;color:rgba(22,21,15,0.7);margin:0 0 20px;max-width:48ch;">
          {t.stone.lead}
        </p>
        <p style="font-size:15px;line-height:1.75;color:rgba(22,21,15,0.45);margin:0;max-width:48ch;">
          {t.stone.note}
        </p>
      </div>

      <!-- Specs table -->
      <div style="display:flex;flex-direction:column;">
        {t.specs.map((r: any) => (
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:18px 0;border-bottom:1px solid rgba(22,21,15,0.12);">
            <span style="font-family:${bodyFont};font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(22,21,15,0.5);">
              {r.k}
            </span>
            <span style={`font-family:${monoFont};font-size:14px;color:#16150F;text-align:end;`}>
              {r.v}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Galerie macros -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:72px;">
      {['macro_polished.jpg — Surface polie', 'macro_honed.jpg — Surface adoucie', 'edge_detail.jpg — Détail chant'].map((label) => (
        <div set:html={ph(label, '4/3', false)} />
      ))}
    </div>

  </div>
</section>

<!-- ══════════════════════════════════════
     LA CARRIÈRE
══════════════════════════════════════ -->
<section id="carriere" style="padding:118px 40px;border-bottom:1px solid rgba(237,235,228,0.09);">
  <div style="max-width:1280px;margin:0 auto;">

    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:40px;`}>
      {t.quarry.label}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">

      <!-- Image carrière -->
      <div set:html={ph('quarry_face_wide.jpg — 800 × 1060 px', '3/4')} />

      <div>
        <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(34px,3.6vw,54px);line-height:1.08;letter-spacing:-0.022em;margin:0 0 28px;`}>
          {t.quarry.title}
        </h2>
        <p style={`font-size:17px;line-height:1.78;color:${muted};margin:0 0 20px;max-width:46ch;`}>
          {t.quarry.p1}
        </p>
        <p style="font-size:17px;line-height:1.78;color:rgba(237,235,228,0.42);margin:0 0 44px;max-width:46ch;">
          {t.quarry.p2}
        </p>

        <!-- Faits carrière -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(237,235,228,0.09);">
          {t.quarryFacts.map((f: any) => (
            <div style="padding:18px 20px;background:#0B0B09;">
              <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(237,235,228,0.38);margin-bottom:6px;`}>
                {f.k}
              </div>
              <div style={`font-family:${titleFont};font-weight:500;font-size:18px;color:${light};`}>
                {f.v}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     FINITIONS & FORMATS
══════════════════════════════════════ -->
<section id="finitions" style="background:#F2F0EC;color:#16150F;padding:118px 40px;">
  <div style="max-width:1280px;margin:0 auto;">

    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(22,21,15,0.45);margin-bottom:16px;`}>
      {t.finishes.label}
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:56px;">
      <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(34px,3.8vw,56px);line-height:1.06;letter-spacing:-0.022em;margin:0;`}>
        {t.finishes.title}
      </h2>
      <p style="font-size:17px;line-height:1.75;color:rgba(22,21,15,0.6);margin:0;">
        {t.finishes.lead}
      </p>
    </div>

    <!-- Finitions grid -->
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:80px;">
      {t.finishItems.map((f: any) => (
        <div>
          <div set:html={ph(f.img, '1/1', false)} />
          <div style="padding:16px 0 0;">
            <div style={`font-family:${titleFont};font-weight:500;font-size:15px;color:#16150F;margin-bottom:6px;`}>{f.n}</div>
            <div style="font-size:13px;line-height:1.6;color:rgba(22,21,15,0.55);">{f.d}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Formats grid -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(22,21,15,0.12);border:1px solid rgba(22,21,15,0.12);">
      {t.formatItems.map((f: any) => (
        <div style="background:#F2F0EC;padding:32px 28px;">
          <div style={`font-family:${titleFont};font-weight:500;font-size:17px;color:#16150F;margin-bottom:16px;`}>
            {f.n}
          </div>
          <div style={`font-family:${monoFont};font-size:13px;line-height:2;color:rgba(22,21,15,0.55);white-space:pre-line;`}>
            {f.s}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- ══════════════════════════════════════
     RÉFÉRENCES
══════════════════════════════════════ -->
<section style="padding:118px 40px;border-bottom:1px solid rgba(237,235,228,0.09);">
  <div style="max-width:1280px;margin:0 auto;">

    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:40px;`}>
      {t.works.label}
    </div>
    <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(30px,3.4vw,50px);line-height:1.08;letter-spacing:-0.022em;margin:0 0 56px;max-width:24ch;`}>
      {t.works.title}
    </h2>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {t.works.items.map((w: any) => (
        <div>
          <div set:html={ph(`${w.img} — ${w.n}`, '4/3')} />
          <div style="padding:20px 0 0;display:flex;justify-content:space-between;align-items:baseline;">
            <span style={`font-family:${titleFont};font-weight:500;font-size:16px;color:${light};`}>{w.n}</span>
            <span style={`font-family:${monoFont};font-size:12px;color:rgba(237,235,228,0.4);`}>{w.loc}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- ══════════════════════════════════════
     EXPORT & LOGISTIQUE
══════════════════════════════════════ -->
<section id="export" style="background:#F2F0EC;color:#16150F;padding:118px 40px;">
  <div style="max-width:1280px;margin:0 auto;">

    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(22,21,15,0.45);margin-bottom:40px;`}>
      {t.exp.label}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">
      <div>
        <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(32px,3.6vw,52px);line-height:1.08;letter-spacing:-0.022em;margin:0 0 24px;`}>
          {t.exp.title}
        </h2>
        <p style="font-size:17px;line-height:1.78;color:rgba(22,21,15,0.6);margin:0 0 44px;max-width:44ch;">
          {t.exp.lead}
        </p>

        <!-- Certifications -->
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          {t.certItems.map((c: any) => (
            <span style="padding:8px 14px;border:1px solid rgba(22,21,15,0.2);font-size:12px;letter-spacing:0.06em;color:rgba(22,21,15,0.65);">
              {c}
            </span>
          ))}
        </div>
      </div>

      <!-- Tableau logistique -->
      <div>
        {t.expItems.map((e: any, i: number) => (
          <div style={`display:flex;justify-content:space-between;gap:24px;padding:20px 0;${i < t.expItems.length - 1 ? 'border-bottom:1px solid rgba(22,21,15,0.12);' : ''}`}>
            <span style="font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(22,21,15,0.5);flex-shrink:0;padding-top:2px;">
              {e.k}
            </span>
            <span style={`font-family:${monoFont};font-size:13px;color:#16150F;text-align:end;line-height:1.6;`}>
              {e.v}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- ══════════════════════════════════════
     CONTACT
══════════════════════════════════════ -->
<section id="contact" style="padding:118px 40px;border-top:1px solid rgba(237,235,228,0.09);">
  <div style="max-width:1280px;margin:0 auto;">

    <div style={`font-family:${monoFont};font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:40px;`}>
      {t.contact.label}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <div>
        <h2 style={`font-family:${titleFont};font-weight:500;font-size:clamp(32px,3.6vw,52px);line-height:1.08;letter-spacing:-0.022em;margin:0 0 20px;`}>
          {t.contact.title}
        </h2>
        <p style={`font-size:17px;line-height:1.78;color:${muted};margin:0 0 36px;max-width:44ch;`}>
          {t.contact.lead}
        </p>
        <p style="font-size:14px;color:rgba(237,235,228,0.35);line-height:1.6;">
          {t.contact.note}
        </p>
      </div>

      <!-- Formulaire -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        action="/success/"
        style="display:flex;flex-direction:column;gap:16px;"
      >
        <input type="hidden" name="form-name" value="contact" />

        <!-- Type de besoin -->
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
          {t.contact.needs.map((n: any, i: number) => (
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="radio" name="need" value={n} style="accent-color:#C8A96A;" checked={i === 0} />
              <span style="font-size:13px;color:rgba(237,235,228,0.7);">{n}</span>
            </label>
          ))}
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <input
            type="text"
            name="name"
            placeholder={t.contact.f_name}
            required
            style={`background:rgba(237,235,228,0.05);border:1px solid rgba(237,235,228,0.15);color:${light};padding:14px 16px;font-family:${bodyFont};font-size:14px;outline:none;transition:border-color 0.2s;`}
            onfocus="this.style.borderColor='#C8A96A'"
            onblur="this.style.borderColor='rgba(237,235,228,0.15)'"
          />
          <input
            type="text"
            name="company"
            placeholder={t.contact.f_company}
            style={`background:rgba(237,235,228,0.05);border:1px solid rgba(237,235,228,0.15);color:${light};padding:14px 16px;font-family:${bodyFont};font-size:14px;outline:none;transition:border-color 0.2s;`}
            onfocus="this.style.borderColor='#C8A96A'"
            onblur="this.style.borderColor='rgba(237,235,228,0.15)'"
          />
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <input
            type="email"
            name="email"
            placeholder={t.contact.f_email}
            required
            style={`background:rgba(237,235,228,0.05);border:1px solid rgba(237,235,228,0.15);color:${light};padding:14px 16px;font-family:${bodyFont};font-size:14px;outline:none;transition:border-color 0.2s;`}
            onfocus="this.style.borderColor='#C8A96A'"
            onblur="this.style.borderColor='rgba(237,235,228,0.15)'"
          />
          <input
            type="text"
            name="country"
            placeholder={t.contact.f_country}
            style={`background:rgba(237,235,228,0.05);border:1px solid rgba(237,235,228,0.15);color:${light};padding:14px 16px;font-family:${bodyFont};font-size:14px;outline:none;transition:border-color 0.2s;`}
            onfocus="this.style.borderColor='#C8A96A'"
            onblur="this.style.borderColor='rgba(237,235,228,0.15)'"
          />
        </div>

        <textarea
          name="message"
          placeholder={t.contact.f_msg}
          rows="4"
          style={`background:rgba(237,235,228,0.05);border:1px solid rgba(237,235,228,0.15);color:${light};padding:14px 16px;font-family:${bodyFont};font-size:14px;outline:none;resize:vertical;transition:border-color 0.2s;`}
          onfocus="this.style.borderColor='#C8A96A'"
          onblur="this.style.borderColor='rgba(237,235,228,0.15)'"></textarea>

        <button
          type="submit"
          style={`padding:16px 32px;background:${accent};color:${dark};font-family:${bodyFont};font-size:13px;letter-spacing:0.14em;text-transform:uppercase;border:none;align-self:flex-start;transition:background 0.2s;`}
          onmouseover="this.style.background='#EDEBE4'"
          onmouseout={`this.style.background='${accent}'`}
        >
          {t.contact.submit}
        </button>

      </form>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     FOOTER
══════════════════════════════════════ -->
<footer style="padding:48px 40px;border-top:1px solid rgba(237,235,228,0.09);display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;">
  <div>
    <div style={`font-family:${titleFont};font-weight:600;font-size:15px;letter-spacing:0.06em;text-transform:uppercase;color:${light};margin-bottom:12px;`}>
      The Stone Family
    </div>
    <p style="font-size:13px;line-height:1.7;color:rgba(237,235,228,0.35);max-width:44ch;">
      {t.footer.tagline}
    </p>
    <p style="font-size:12px;color:rgba(237,235,228,0.25);margin-top:8px;">
      {t.footer.addr}
    </p>
  </div>
  <div style="text-align:end;">
    <p style="font-size:12px;color:rgba(237,235,228,0.25);">
      {t.footer.rights}
    </p>
  </div>
</footer>
