---
interface Props {
  t: any;
}
const { t } = Astro.props;
const accent = '#C8A96A';
const dark = '#0B0B09';
const light = '#EDEBE4';
const muted = 'rgba(237,235,228,0.55)';
const monoFont = "'IBM Plex Mono','Noto Kufi Arabic',monospace";
const titleFont = "'Archivo','Noto Kufi Arabic',system-ui,sans-serif";
const bodyFont = "'Barlow','Noto Kufi Arabic',system-ui,sans-serif";

const ph = (label: string) => `
  <div class="img-ph">
    <span>${label}</span>
  </div>`;
---

<style>
  /* ── RESET & BASE ─────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }

  /* ── PLACEHOLDERS PHOTO ───────────────────── */
  .img-ph {
    width: 100%;
    aspect-ratio: 4/3;
    background: repeating-linear-gradient(122deg, #131209 0 10px, #191811 10px 20px);
    display: flex;
    align-items: flex-end;
    padding: 16px;
    border: 1px solid rgba(237,235,228,0.09);
  }
  .img-ph span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(237,235,228,0.3);
  }
  .img-ph-light {
    background: repeating-linear-gradient(122deg, #DCD8D0 0 10px, #E6E2DA 10px 20px);
    border-color: rgba(22,21,15,0.09);
  }
  .img-ph-light span { color: rgba(22,21,15,0.3); }

  /* ── LABEL ────────────────────────────────── */
  .section-label {
    font-family: 'IBM Plex Mono', 'Noto Kufi Arabic', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .section-label.on-dark { color: #C8A96A; }
  .section-label.on-light { color: rgba(22,21,15,0.45); }

  /* ── HERO ─────────────────────────────────── */
  .hero {
    background: #0B0B09;
    border-bottom: 1px solid rgba(237,235,228,0.09);
  }
  .hero-content {
    padding: 56px 20px 48px;
  }
  .hero-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C8A96A;
    margin-bottom: 28px;
  }
  .hero-h1 {
    font-family: 'Archivo', 'Noto Kufi Arabic', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(36px, 8vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.028em;
    color: #EDEBE4;
    margin: 0 0 28px;
  }
  .hero-lead {
    font-size: clamp(15px, 3vw, 18px);
    line-height: 1.75;
    color: rgba(237,235,228,0.55);
    margin: 0 0 40px;
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero-img {
    width: 100%;
    min-height: 260px;
    background: repeating-linear-gradient(122deg, #131209 0 10px, #191811 10px 20px);
    border-top: 1px solid rgba(237,235,228,0.09);
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }
  .hero-img span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(237,235,228,0.25);
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: #EDEBE4;
    color: #0B0B09;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
    width: fit-content;
  }
  .btn-secondary {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #EDEBE4;
    border-bottom: 1px solid rgba(200,169,106,0.4);
    padding-bottom: 3px;
    text-decoration: none;
    width: fit-content;
  }

  /* ── STATS ────────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid rgba(237,235,228,0.09);
  }
  .stat-item {
    padding: 28px 20px;
    border-right: 1px solid rgba(237,235,228,0.09);
    border-bottom: 1px solid rgba(237,235,228,0.09);
  }
  .stat-item:nth-child(2n) { border-right: none; }
  .stat-item:nth-last-child(-n+2) { border-bottom: none; }
  .stat-value {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: -0.025em;
    line-height: 1;
    color: #C8A96A;
    margin-bottom: 10px;
  }
  .stat-label {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(237,235,228,0.4);
  }

  /* ── SECTIONS ─────────────────────────────── */
  .section-dark { background: #0B0B09; padding: 64px 20px; border-bottom: 1px solid rgba(237,235,228,0.09); }
  .section-light { background: #F2F0EC; color: #16150F; padding: 64px 20px; }
  .section-mid { background: #0B0B09; padding: 64px 20px; border-top: 1px solid rgba(237,235,228,0.09); }

  /* ── GRILLES RESPONSIVE ───────────────────── */
  .grid-2 { display: grid; grid-template-columns: 1fr; gap: 40px; }
  .grid-3 { display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(237,235,228,0.09); border: 1px solid rgba(237,235,228,0.09); }
  .grid-3-light { display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(22,21,15,0.12); border: 1px solid rgba(22,21,15,0.12); }
  .grid-5 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .grid-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(237,235,228,0.09); }

  /* ── TITRES ───────────────────────────────── */
  .h2-dark {
    font-family: 'Archivo', 'Noto Kufi Arabic', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: #EDEBE4;
    margin: 0 0 20px;
  }
  .h2-light {
    font-family: 'Archivo', 'Noto Kufi Arabic', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: #16150F;
    margin: 0 0 20px;
  }
  .lead-dark { font-size: clamp(15px, 2.5vw, 17px); line-height: 1.78; color: rgba(237,235,228,0.55); margin: 0 0 16px; }
  .lead-light { font-size: clamp(15px, 2.5vw, 17px); line-height: 1.78; color: rgba(22,21,15,0.65); margin: 0 0 16px; }

  /* ── SPECS TABLE ──────────────────────────── */
  .specs-table { display: flex; flex-direction: column; margin-top: 24px; }
  .spec-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(22,21,15,0.12); }
  .spec-row:last-child { border-bottom: none; }
  .spec-key { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(22,21,15,0.5); flex-shrink: 0; }
  .spec-val { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #16150F; text-align: end; }

  /* ── FACTS CARRIÈRE ───────────────────────── */
  .fact-item { background: #0B0B09; padding: 20px; }
  .fact-key { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(237,235,228,0.38); margin-bottom: 6px; }
  .fact-val { font-family: 'Archivo', system-ui, sans-serif; font-weight: 500; font-size: clamp(15px, 2.5vw, 18px); color: #EDEBE4; }

  /* ── FINITIONS ────────────────────────────── */
  .finish-card { background: #F2F0EC; }
  .finish-swatch { aspect-ratio: 1/1; }
  .finish-name { font-family: 'Archivo', system-ui, sans-serif; font-weight: 500; font-size: 14px; color: #16150F; margin-bottom: 6px; }
  .finish-desc { font-size: 12px; line-height: 1.6; color: rgba(22,21,15,0.55); }
  .finish-info { padding: 14px 0; }

  /* ── FORMATS ──────────────────────────────── */
  .format-card { background: #F2F0EC; padding: 28px 24px; }
  .format-name { font-family: 'Archivo', system-ui, sans-serif; font-weight: 500; font-size: 16px; color: #16150F; margin-bottom: 14px; }
  .format-specs { font-family: 'IBM Plex Mono', monospace; font-size: 12px; line-height: 2; color: rgba(22,21,15,0.55); white-space: pre-line; }

  /* ── RÉFÉRENCES ───────────────────────────── */
  .ref-card { }
  .ref-info { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0 0; }
  .ref-name { font-family: 'Archivo', system-ui, sans-serif; font-weight: 500; font-size: 15px; color: #EDEBE4; }
  .ref-loc { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: rgba(237,235,228,0.4); }

  /* ── EXPORT ───────────────────────────────── */
  .cert-tag { display: inline-block; padding: 7px 12px; border: 1px solid rgba(22,21,15,0.2); font-size: 12px; letter-spacing: 0.06em; color: rgba(22,21,15,0.65); margin: 4px; }
  .exp-row { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; border-bottom: 1px solid rgba(22,21,15,0.12); }
  .exp-row:last-child { border-bottom: none; }
  .exp-key { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(22,21,15,0.5); }
  .exp-val { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #16150F; line-height: 1.6; }

  /* ── FORMULAIRE ───────────────────────────── */
  .form-input {
    width: 100%;
    background: rgba(237,235,228,0.05);
    border: 1px solid rgba(237,235,228,0.15);
    color: #EDEBE4;
    padding: 14px 16px;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }
  .form-input:focus { border-color: #C8A96A; }
  .form-grid-2 { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .radio-group { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
  .radio-label { display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px; color: rgba(237,235,228,0.7); }

  /* ── FOOTER ───────────────────────────────── */
  .footer { padding: 40px 20px; border-top: 1px solid rgba(237,235,228,0.09); }
  .footer-tagline { font-size: 13px; line-height: 1.7; color: rgba(237,235,228,0.35); margin: 8px 0; max-width: 44ch; }
  .footer-addr { font-size: 12px; color: rgba(237,235,228,0.25); }
  .footer-rights { font-size: 12px; color: rgba(237,235,228,0.25); margin-top: 24px; }

  /* ── DESKTOP ──────────────────────────────── */
  @media (min-width: 700px) {
    .hero-actions { flex-direction: row; align-items: center; }
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
    .stat-item { border-bottom: none; }
    .stat-item:nth-child(2n) { border-right: 1px solid rgba(237,235,228,0.09); }
    .stat-item:last-child { border-right: none; }
    .grid-5 { grid-template-columns: repeat(3, 1fr); }
    .form-grid-2 { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 900px) {
    .section-dark, .section-light, .section-mid { padding: 96px 40px; }
    .hero-content { padding: 80px 40px 72px; max-width: 55%; }
    .hero { display: grid; grid-template-columns: 1fr 1fr; }
    .hero-img { border-top: none; border-left: 1px solid rgba(237,235,228,0.09); min-height: 500px; }
    .grid-2 { grid-template-columns: 1fr 1fr; }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-3-light { grid-template-columns: repeat(3, 1fr); }
    .grid-5 { grid-template-columns: repeat(5, 1fr); }
    .grid-facts { grid-template-columns: repeat(3, 1fr); }
    .footer { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
    .footer-rights { margin-top: 0; text-align: end; }
  }

  @media (min-width: 1100px) {
    .grid-facts { grid-template-columns: repeat(6, 1fr); }
  }
</style>

<!-- ══ HERO ══════════════════════════════════ -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-eyebrow">{t.hero.eyebrow}</div>
    <h1 class="hero-h1" set:html={t.hero.h1.replace('\n', '<br>')} />
    <p class="hero-lead">{t.hero.lead}</p>
    <div class="hero-actions">
      <a href="#pierre" class="btn-primary">{t.hero.cta_primary} <span>→</span></a>
      <a href="#contact" class="btn-secondary">{t.hero.cta_secondary}</a>
    </div>
  </div>
  <div class="hero-img">
    <span>hero_slab_polished.jpg — 1200 × 900 px</span>
  </div>
</section>

<!-- ══ STATS ═════════════════════════════════ -->
<div class="stats-grid">
  {t.stats.map((s: any) => (
    <div class="stat-item">
      <div class="stat-value">{s.v}</div>
      <div class="stat-label">{s.l}</div>
    </div>
  ))}
</div>

<!-- ══ LA PIERRE ═════════════════════════════ -->
<section class="section-light" id="pierre">
  <div class="section-label on-light">{t.stone.label}</div>
  <div class="grid-2" style="align-items:start;">
    <div>
      <h2 class="h2-light">{t.stone.title}</h2>
      <p class="lead-light">{t.stone.lead}</p>
      <p style="font-size:14px;line-height:1.75;color:rgba(22,21,15,0.45);margin:0;">{t.stone.note}</p>
      <div class="specs-table">
        {t.specs.map((r: any) => (
          <div class="spec-row">
            <span class="spec-key">{r.k}</span>
            <span class="spec-val">{r.v}</span>
          </div>
        ))}
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:8px;">
      {['macro_polished.jpg', 'macro_honed.jpg', 'edge_detail.jpg'].map((img) => (
        <div class="img-ph img-ph-light" style="aspect-ratio:3/4;">
          <span>{img}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ LA CARRIÈRE ═══════════════════════════ -->
<section class="section-dark" id="carriere">
  <div class="section-label on-dark">{t.quarry.label}</div>
  <div class="grid-2" style="align-items:center;">
    <div class="img-ph" style="aspect-ratio:3/4;order:2;">
      <span>quarry_face_wide.jpg — 800 × 1060 px</span>
    </div>
    <div style="order:1;">
      <h2 class="h2-dark">{t.quarry.title}</h2>
      <p class="lead-dark">{t.quarry.p1}</p>
      <p style="font-size:16px;line-height:1.78;color:rgba(237,235,228,0.42);margin:0 0 36px;">{t.quarry.p2}</p>
      <div class="grid-facts">
        {t.quarryFacts.map((f: any) => (
          <div class="fact-item">
            <div class="fact-key">{f.k}</div>
            <div class="fact-val">{f.v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ══ FINITIONS & FORMATS ═══════════════════ -->
<section class="section-light" id="finitions">
  <div class="section-label on-light">{t.finishes.label}</div>
  <div class="grid-2" style="align-items:end;margin-bottom:48px;">
    <h2 class="h2-light" style="margin:0;">{t.finishes.title}</h2>
    <p class="lead-light" style="margin:0;">{t.finishes.lead}</p>
  </div>

  <!-- Finitions -->
  <div class="grid-5" style="margin-bottom:56px;">
    {t.finishItems.map((f: any) => (
      <div class="finish-card">
        <div class="img-ph img-ph-light finish-swatch"><span>{f.img}</span></div>
        <div class="finish-info">
          <div class="finish-name">{f.n}</div>
          <div class="finish-desc">{f.d}</div>
        </div>
      </div>
    ))}
  </div>

  <!-- Formats -->
  <div class="grid-3-light">
    {t.formatItems.map((f: any) => (
      <div class="format-card">
        <div class="format-name">{f.n}</div>
        <div class="format-specs">{f.s}</div>
      </div>
    ))}
  </div>
</section>

<!-- ══ RÉFÉRENCES ════════════════════════════ -->
<section class="section-dark">
  <div class="section-label on-dark">{t.works.label}</div>
  <h2 class="h2-dark" style="max-width:20ch;margin-bottom:48px;">{t.works.title}</h2>
  <div class="grid-3">
    {t.works.items.map((w: any) => (
      <div class="ref-card">
        <div class="img-ph"><span>{w.img} — {w.n}</span></div>
        <div class="ref-info">
          <span class="ref-name">{w.n}</span>
          <span class="ref-loc">{w.loc}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ══ EXPORT ════════════════════════════════ -->
<section class="section-light" id="export">
  <div class="section-label on-light">{t.exp.label}</div>
  <div class="grid-2" style="align-items:start;">
    <div>
      <h2 class="h2-light">{t.exp.title}</h2>
      <p class="lead-light">{t.exp.lead}</p>
      <div style="display:flex;flex-wrap:wrap;margin-top:28px;">
        {t.certItems.map((c: any) => (
          <span class="cert-tag">{c}</span>
        ))}
      </div>
    </div>
    <div>
      {t.expItems.map((e: any) => (
        <div class="exp-row">
          <span class="exp-key">{e.k}</span>
          <span class="exp-val">{e.v}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ CONTACT ═══════════════════════════════ -->
<section class="section-mid" id="contact">
  <div class="section-label on-dark">{t.contact.label}</div>
  <div class="grid-2" style="align-items:start;">
    <div>
      <h2 class="h2-dark">{t.contact.title}</h2>
      <p class="lead-dark">{t.contact.lead}</p>
      <p style="font-size:14px;color:rgba(237,235,228,0.35);line-height:1.6;margin-top:20px;">{t.contact.note}</p>
    </div>
    <form name="contact" method="POST" data-netlify="true" action="/success/" style="display:flex;flex-direction:column;gap:14px;">
      <input type="hidden" name="form-name" value="contact" />
      <div class="radio-group">
        {t.contact.needs.map((n: any, i: number) => (
          <label class="radio-label">
            <input type="radio" name="need" value={n} style="accent-color:#C8A96A;" checked={i === 0} />
            {n}
          </label>
        ))}
      </div>
      <div class="form-grid-2">
        <input type="text" name="name" placeholder={t.contact.f_name} required class="form-input" />
        <input type="text" name="company" placeholder={t.contact.f_company} class="form-input" />
      </div>
      <div class="form-grid-2">
        <input type="email" name="email" placeholder={t.contact.f_email} required class="form-input" />
        <input type="text" name="country" placeholder={t.contact.f_country} class="form-input" />
      </div>
      <textarea name="message" placeholder={t.contact.f_msg} rows="4" class="form-input" style="resize:vertical;"></textarea>
      <button type="submit"
        style={`padding:16px 32px;background:${accent};color:${dark};font-family:'Barlow',system-ui,sans-serif;font-size:13px;letter-spacing:0.14em;text-transform:uppercase;border:none;cursor:pointer;align-self:flex-start;transition:background 0.2s;`}
        onmouseover={`this.style.background='#EDEBE4'`}
        onmouseout={`this.style.background='${accent}'`}
      >{t.contact.submit}</button>
    </form>
  </div>
</section>

<!-- ══ FOOTER ════════════════════════════════ -->
<footer class="footer">
  <div>
    <div style={`font-family:${titleFont};font-weight:600;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:${light};`}>The Stone Family</div>
    <p class="footer-tagline">{t.footer.tagline}</p>
    <p class="footer-addr">{t.footer.addr}</p>
  </div>
  <p class="footer-rights">{t.footer.rights}</p>
</footer>

<!-- Bouton WhatsApp flottant -->
<a href="https://wa.me/212660850700" target="_blank" rel="noopener" title="WhatsApp"
  style="position:fixed;bottom:24px;right:24px;z-index:999;display:flex;align-items:center;justify-content:center;width:52px;height:52px;background:#25D366;border-radius:50%;box-shadow:0 4px 16px rgba(37,211,102,0.4);transition:transform 0.2s;text-decoration:none;"
  onmouseover="this.style.transform='scale(1.1)'"
