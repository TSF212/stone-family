---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { t, type Locale } from '../i18n/index';

// Détecte la langue depuis le header Referer ou Accept-Language
// Par défaut FR — Netlify redirige vers /success quelle que soit la langue
const locale: Locale = 'fr';
const tr = t(locale);

const successContent = {
  fr: {
    tag: 'Demande reçue',
    h1: 'Votre demande\na bien été envoyée.',
    lead: 'Notre équipe vous répond sous 24 heures ouvrées. Pour une réponse immédiate, contactez-nous directement sur WhatsApp.',
    wa: 'Écrire sur WhatsApp',
    stats: [
      { v: '5 j', l: 'De la carrière au port de Casablanca' },
      { v: '0', l: 'Veine ou fissure visible dans notre marbre' },
      { v: '1', l: 'Seule carrière — une source, une teinte' },
    ],
    prods_label: 'Nos produits',
    prods: [
      { tag: 'Extraction directe', n: 'Blocs bruts', d: '2,80 × 1,60 × 1,60 m — Sélection A/B', lnk: 'Voir les formats →' },
      { tag: '5 finitions', n: 'Tranches & Dalles', d: '2/3 cm — 280 × 160 cm — Poli, adouci, sablé...', lnk: 'Voir les finitions →' },
      { tag: 'Funéraire · Pavés · Gravillon', n: 'Gamme complète', d: 'Stèles, bordures, pavés, gravillon 0–32 mm', lnk: 'Voir la gamme →' },
    ],
    back: '← Retour à l\'accueil',
    title: 'Demande envoyée — The Stone Family',
    desc: 'Votre demande a bien été reçue. Nous vous répondons sous 24h.',
  },
  en: {
    tag: 'Request received',
    h1: 'Your request\nhas been sent.',
    lead: 'Our team will reply within 24 working hours. For an immediate response, contact us directly on WhatsApp.',
    wa: 'Write on WhatsApp',
    stats: [
      { v: '5 d', l: 'From quarry to Casablanca port' },
      { v: '0', l: 'Veins or cracks visible in our marble' },
      { v: '1', l: 'Single quarry — one source, one shade' },
    ],
    prods_label: 'Our products',
    prods: [
      { tag: 'Direct extraction', n: 'Raw blocks', d: '2.80 × 1.60 × 1.60 m — Grade A/B', lnk: 'See formats →' },
      { tag: '5 finishes', n: 'Slabs', d: '2/3 cm — 280 × 160 cm — Polished, honed, sandblasted...', lnk: 'See finishes →' },
      { tag: 'Funerary · Paving · Gravel', n: 'Full range', d: 'Headstones, kerbs, paving, gravel 0–32 mm', lnk: 'See range →' },
    ],
    back: '← Back to home',
    title: 'Request sent — The Stone Family',
    desc: 'Your request has been received. We will reply within 24h.',
  },
  it: {
    tag: 'Richiesta ricevuta',
    h1: 'La sua richiesta\nè stata inviata.',
    lead: 'Il nostro team risponderà entro 24 ore lavorative. Per una risposta immediata, contattateci direttamente su WhatsApp.',
    wa: 'Scrivere su WhatsApp',
    stats: [
      { v: '5 gg', l: 'Dalla cava al porto di Casablanca' },
      { v: '0', l: 'Venature o crepe visibili nel nostro marmo' },
      { v: '1', l: 'Cava unica — una fonte, una tonalità' },
    ],
    prods_label: 'I nostri prodotti',
    prods: [
      { tag: 'Estrazione diretta', n: 'Blocchi grezzi', d: '2,80 × 1,60 × 1,60 m — Selezione A/B', lnk: 'Vedere i formati →' },
      { tag: '5 finiture', n: 'Lastre', d: '2/3 cm — 280 × 160 cm — Lucidato, levigato, sabbiato...', lnk: 'Vedere le finiture →' },
      { tag: 'Funerario · Pavé · Ghiaia', n: 'Gamma completa', d: 'Stele, cordoli, pavé, ghiaia 0–32 mm', lnk: 'Vedere la gamma →' },
    ],
    back: '← Torna alla home',
    title: 'Richiesta inviata — The Stone Family',
    desc: 'La sua richiesta è stata ricevuta. Risponderemo entro 24 ore.',
  },
  es: {
    tag: 'Solicitud recibida',
    h1: 'Su solicitud\nha sido enviada.',
    lead: 'Nuestro equipo le responderá en 24 horas hábiles. Para una respuesta inmediata, contáctenos directamente en WhatsApp.',
    wa: 'Escribir en WhatsApp',
    stats: [
      { v: '5 d', l: 'Desde la cantera al puerto de Casablanca' },
      { v: '0', l: 'Venas o grietas visibles en nuestro mármol' },
      { v: '1', l: 'Cantera única — una fuente, un tono' },
    ],
    prods_label: 'Nuestros productos',
    prods: [
      { tag: 'Extracción directa', n: 'Bloques brutos', d: '2,80 × 1,60 × 1,60 m — Selección A/B', lnk: 'Ver formatos →' },
      { tag: '5 acabados', n: 'Losas', d: '2/3 cm — 280 × 160 cm — Pulido, apomazado, abujardado...', lnk: 'Ver acabados →' },
      { tag: 'Funerario · Adoquines · Gravilla', n: 'Gama completa', d: 'Estelas, bordillos, adoquines, gravilla 0–32 mm', lnk: 'Ver gama →' },
    ],
    back: '← Volver al inicio',
    title: 'Solicitud enviada — The Stone Family',
    desc: 'Su solicitud ha sido recibida. Le responderemos en 24 horas.',
  },
  ar: {
    tag: 'تم استلام طلبك',
    h1: 'تم إرسال\nطلبك بنجاح.',
    lead: 'سيرد فريقنا خلال 24 ساعة عمل. للحصول على رد فوري، تواصل معنا مباشرة عبر واتساب.',
    wa: 'الكتابة على واتساب',
    stats: [
      { v: '5 أيام', l: 'من المحجرة إلى ميناء الدار البيضاء' },
      { v: '0', l: 'عروق أو شقوق مرئية في رخامنا' },
      { v: '1', l: 'محجرة واحدة — مصدر واحد، لون واحد' },
    ],
    prods_label: 'منتجاتنا',
    prods: [
      { tag: 'استخراج مباشر', n: 'كتل خام', d: '2,80 × 1,60 × 1,60 م — تصنيف أ/ب', lnk: 'عرض الأحجام ←' },
      { tag: '5 تشطيبات', n: 'ألواح', d: '2/3 سم — 280 × 160 سم — مصقول، مطفأ، مسرشق...', lnk: 'عرض التشطيبات ←' },
      { tag: 'جنائزي · رصيف · حصى', n: 'المجموعة الكاملة', d: 'شواهد، حواف، رصيف، حصى 0–32 مم', lnk: 'عرض المجموعة ←' },
    ],
    back: 'العودة إلى الرئيسية →',
    title: 'تم إرسال الطلب — The Stone Family',
    desc: 'تم استلام طلبك. سنرد خلال 24 ساعة.',
  },
};

const accent = '#C8A96A';
const dark = '#0B0B09';
const light = '#EDEBE4';
const muted = 'rgba(237,235,228,0.55)';
const monoFont = "'IBM Plex Mono','Noto Kufi Arabic',monospace";
const titleFont = "'Archivo','Noto Kufi Arabic',system-ui,sans-serif";
const bodyFont = "'Barlow','Noto Kufi Arabic',system-ui,sans-serif";
---

<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Demande envoyée — The Stone Family</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Barlow:wght@300;400;500&family=IBM+Plex+Mono:wght@400&family=Noto+Kufi+Arabic:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0B0B09;color:#EDEBE4;font-family:'Barlow','Noto Kufi Arabic',system-ui,sans-serif;font-weight:300;-webkit-font-smoothing:antialiased;}
    a{color:inherit;text-decoration:none;}
  </style>
</head>
<body>

<!-- Header complet -->
<header style="position:sticky;top:0;z-index:50;display:flex;align-items:stretch;justify-content:space-between;gap:28px;background:#F2F0EC;border-bottom:1px solid rgba(0,0,0,0.08);">

  <a href="/" style="display:flex;align-items:center;flex:none;padding:0 28px;">
    <img src="/images/logo.png" alt="The Stone Family" style="height:72px;width:auto;display:block;" />
  </a>

  <nav style="display:flex;align-items:center;flex-wrap:wrap;gap:10px 26px;font-size:13px;letter-spacing:0.07em;text-transform:uppercase;">
    <a href="/#pierre" style="color:#1a1a1a;text-decoration:none;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">La pierre</a>
    <a href="/#carriere" style="color:#1a1a1a;text-decoration:none;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">La carrière</a>
    <a href="/#finitions" style="color:#1a1a1a;text-decoration:none;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">Finitions</a>
    <a href="/#export" style="color:#1a1a1a;text-decoration:none;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">Export</a>
    <a href="/#contact" style="color:#1a1a1a;text-decoration:none;" onmouseover="this.style.color='#C8A96A'" onmouseout="this.style.color='#1a1a1a'">Contact</a>
  </nav>

  <div style="display:flex;align-items:center;gap:12px 18px;padding:0 28px;">
    <div id="lang-bar" style={`display:flex;align-items:center;gap:2px;font-family:${monoFont};font-size:11px;letter-spacing:0.12em;`}>
      {['fr','en','it','es','ar'].map((loc) => (
        <button
          onclick={`showLang('${loc}')`}
          id={`btn-${loc}`}
          style={`padding:5px 9px;background:transparent;border:none;cursor:pointer;color:${loc === 'fr' ? '#C8A96A' : 'rgba(0,0,0,0.35)'};font-family:inherit;font-size:inherit;letter-spacing:inherit;`}
        >
          {loc.toUpperCase()}
        </button>
      ))}
    </div>
    <a href="https://wa.me/212660850700" target="_blank" rel="noopener"
      style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;background:#25D366;border-radius:50%;flex-shrink:0;text-decoration:none;"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>

</header>

<!-- Blocs par langue -->
{Object.entries(successContent).map(([lang, c]) => (
  <div id={`lang-${lang}`} style={`display:${lang === 'fr' ? 'block' : 'none'};`} dir={lang === 'ar' ? 'rtl' : 'ltr'}>

    <!-- HERO CONFIRMATION -->
    <section style={`padding:80px 40px 64px;border-bottom:1px solid rgba(237,235,228,0.09);display:flex;flex-direction:column;align-items:center;text-align:center;`}>
      <div style={`width:64px;height:64px;border:1px solid rgba(200,169,106,0.4);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:28px;color:${accent};font-size:26px;`}>✓</div>
      <div style={`font-family:${monoFont};font-size:10px;font-weight:500;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:20px;display:flex;align-items:center;gap:10px;`}>
        <span style="display:inline-block;width:20px;height:1px;background:#C8A96A;"></span>
        {c.tag}
        <span style="display:inline-block;width:20px;height:1px;background:#C8A96A;"></span>
      </div>
      <h1 style={`font-family:${titleFont};font-weight:500;font-size:clamp(32px,4vw,52px);line-height:1.06;letter-spacing:-0.022em;margin:0 0 20px;white-space:pre-line;`}>{c.h1}</h1>
      <p style={`font-size:17px;font-weight:300;line-height:1.75;color:${muted};max-width:46ch;margin:0 0 36px;`}>{c.lead}</p>
      <a
        href="https://wa.me/212660850700"
        target="_blank"
        rel="noopener"
        style={`display:inline-flex;align-items:center;gap:10px;padding:14px 28px;background:#25D366;color:#fff;font-family:${bodyFont};font-size:13px;letter-spacing:0.1em;text-transform:uppercase;`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {c.wa}
      </a>
    </section>

    <!-- STATS -->
    <section style="display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid rgba(237,235,228,0.09);">
      {c.stats.map((s, i) => (
        <div style={`padding:36px 28px;${i < 2 ? 'border-right:1px solid rgba(237,235,228,0.09);' : ''}`}>
          <div style={`font-family:${titleFont};font-weight:500;font-size:clamp(28px,3vw,40px);letter-spacing:-0.022em;line-height:1;color:${accent};margin-bottom:10px;`}>{s.v}</div>
          <div style={`font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(237,235,228,0.4);line-height:1.5;`}>{s.l}</div>
        </div>
      ))}
    </section>

    <!-- PRODUITS -->
    <section style="padding:56px 40px;border-bottom:1px solid rgba(237,235,228,0.09);">
      <div style={`font-family:${monoFont};font-size:10px;font-weight:500;letter-spacing:0.22em;text-transform:uppercase;color:${accent};margin-bottom:24px;`}>{c.prods_label}</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(237,235,228,0.09);border:1px solid rgba(237,235,228,0.09);">
        {c.prods.map((p) => (
          <div style="background:#0B0B09;padding:28px 24px;">
            <div style={`font-family:${monoFont};font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:${accent};border-bottom:1px solid rgba(200,169,106,0.3);padding-bottom:3px;display:inline-block;margin-bottom:14px;`}>{p.tag}</div>
            <div style={`font-family:${titleFont};font-weight:500;font-size:16px;color:${light};margin-bottom:8px;`}>{p.n}</div>
            <div style={`font-family:${monoFont};font-size:12px;color:rgba(237,235,228,0.4);line-height:1.6;margin-bottom:14px;`}>{p.d}</div>
            <a href="/" style={`font-size:11px;font-weight:500;letter-spacing:1px;text-transform:uppercase;color:${accent};`}>{p.lnk}</a>
          </div>
        ))}
      </div>
    </section>

    <!-- RETOUR ACCUEIL -->
    <a href="/" style={`display:block;text-align:center;padding:24px 40px;font-family:${bodyFont};font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(237,235,228,0.4);border-top:1px solid rgba(237,235,228,0.06);transition:color 0.2s;`}
      onmouseover={`this.style.color='${accent}'`}
      onmouseout="this.style.color='rgba(237,235,228,0.4)'"
    >
      {c.back}
    </a>

  </div>
))}

<script>
function showLang(lang) {
  ['fr','en','it','es','ar'].forEach(function(l) {
    document.getElementById('lang-' + l).style.display = l === lang ? 'block' : 'none';
    var btn = document.getElementById('btn-' + l);
    btn.style.color = l === lang ? '#C8A96A' : 'rgba(0,0,0,0.35)';
  });
}
// Détection automatique de la langue du navigateur
var browserLang = (navigator.language || 'fr').substring(0, 2);
var supported = ['fr','en','it','es','ar'];
if (supported.includes(browserLang)) showLang(browserLang);
</script>

</body>
</html>
