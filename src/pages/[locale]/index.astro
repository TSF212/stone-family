---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HomePage from '../../components/HomePage.astro';
import { t, locales, defaultLocale, type Locale } from '../../i18n/index';

// Génère une route statique pour chaque locale (sauf FR qui est à la racine)
export function getStaticPaths() {
  return locales
    .filter((loc) => loc !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const translations = t(locale);
---

<BaseLayout
  title={translations.meta.title}
  description={translations.meta.description}
  locale={locale}
  canonicalPath=""
>
  <Header t={translations} locale={locale} currentPath="" />
  <main>
    <HomePage t={translations} />
  </main>
</BaseLayout>
