---
import SupplyPage from '../components/SupplyPage.astro';
import { supplyContent, type SupplyKind } from '../i18n/supply';

export function getStaticPaths() {
  return (['blocks', 'slabs'] as SupplyKind[]).map(kind => ({
    params: { supply: supplyContent.fr[kind].slug }, props: { kind },
  }));
}
---
<SupplyPage locale="fr" kind={Astro.props.kind} />
